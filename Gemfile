source "https://rubygems.org"

# Note: GitHub Pages actually builds this site on its own infrastructure using
# its pinned `github-pages` gem set — that happens independently of this
# Gemfile. We use plain `jekyll` here for local preview because `github-pages`
# pins an old Jekyll/Liquid that no longer runs on modern Ruby (it calls the
# removed String#tainted? method).
gem 'jekyll'
gem 'webrick'
